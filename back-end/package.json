{
  "name": "monastir-airport-backend",
  "version": "1.0.0",
  "description": "REST API + Power BI data service for the Monastir Airport Operations Intelligence dashboard",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "extract:powerbi": "node src/seed/extractPowerBi.js",
    "import:powerbi": "node src/seed/importPowerBi.js",
    "sync:powerbi": "npm run extract:powerbi && npm run import:powerbi"
  },
  "keywords": [
    "airport",
    "operations",
    "bi",
    "mongodb",
    "powerbi",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
