# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/pfe
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pfe?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/pfe

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# Power BI
# Optional API key. If set, /api/bi/* endpoints require header "x-api-key".
# Power BI users can use the key directly, or leave BI endpoints public by omitting it.
BI_API_KEY=

# Frontend origin allowed by CORS (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3111
